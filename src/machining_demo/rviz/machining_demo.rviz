      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        world:
          panda_link0:
            machine:
              {}
            panda_link1:
              panda_link2:
                panda_link3:
                  panda_link4:
                    panda_link5:
                      panda_link6:
                        panda_link7:
