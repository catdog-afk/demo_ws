    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: TaskStatus
      Namespaces:
        task_status: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /task/status_marker
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: MachineStatus
      Namespaces:
        machine_status: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /machine/status_marker
